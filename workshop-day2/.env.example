# Copy to .env only if you want to run against a real model. The lab works
# completely without this file.

# mock       deterministic scripted model. No key, no network, no cost.
#            Every demo and every proof in the workshop uses this.
# openrouter a real LLM, so you can watch a genuine model get steered.
LLM_PROVIDER=mock

# Llama 3.1 8B on OpenRouter - the hosted twin of the ollama model below.
# llama-3.1-8b-instruct is the default: non-reasoning, fast, and a good victim.
KESTREL_MODEL=meta-llama/llama-3.1-8b-instruct
OPENROUTER_API_KEY=

# Pre-set the build you want. Leave blank for the shipped (vulnerable) build.
# SECURE_TENANCY=1
# SECURE_TOOLS=1

# The OpenRouter endpoint. Override only to point at a proxy or a compatible
# gateway - the default is OpenRouter itself.
OPENROUTER_BASE=https://openrouter.ai/api/v1

# ---- deploying this somewhere (Railway, Fly, a VM) - see ../DEPLOY.md --------
# Set a password and every request needs it first. Leave it unset locally.
# An exposed lab with a real API key is attack b8 pointed at your own balance.
# KESTREL_ACCESS_PASSWORD=

# The platform sets these; you rarely set them by hand.
# PORT=8000
# HOST=127.0.0.1          # 0.0.0.0 to accept connections from the network
